---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.tsx';
import MyWork from '../components/MyWork.tsx';
import CustomerReview from '../components/CustomerReview.tsx';
import InstagramSection from '../components/InstagramSection.tsx';
import YoutubeSection from '../components/YoutubeSection.tsx';
import AboutMe from '../components/AboutMe.tsx';
import BookingDrawer from '../components/booking/BookingDrawer.tsx';
---

<Layout
  title="Cherrybrush |  Booking Service - Nail Art Studio in Jaipur"
  description="Cherrybrush | Booking Service is Jaipur's top nail art studio. Book appointments online for nail extensions, gel nail art, bridal nails, and nail services in Jaipur, Rajasthan, India."
  keywords="nail art studio in jaipur, appointment booking for nails in jaipur, nail salon jaipur, nail extensions jaipur, nail art jaipur india, cherrybrush jaipur, book nail appointment jaipur"
>
	<Hero client:visible />
	<MyWork client:visible />
	<CustomerReview client:visible />
	<InstagramSection client:visible />
	<YoutubeSection client:load />
	<AboutMe client:visible />
	<BookingDrawer client:load />
</Layout>
